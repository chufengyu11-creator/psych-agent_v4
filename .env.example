APP_ENV=development
APP_RUNTIME_MODE=in_memory
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://psych_agent:replace-me@127.0.0.1:5432/psych_agent
TEST_DATABASE_URL=postgresql+asyncpg://psych_agent:replace-me@127.0.0.1:5432/psych_agent_test
POSTGRES_USER=psych_agent
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=psych_agent
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Single-model fallback. Existing one-endpoint deployments can keep this section.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me
MAIN_MODEL_NAME=deepseek-v4-flash
STRUCTURED_MODEL_NAME=deepseek-v4-flash
SAFETY_MODEL_NAME=deepseek-v4-flash

# Optional model-name -> OpenAI-compatible endpoint routing.
# Use one-line JSON. Keys must exactly match each server's GET /v1/models ID.
LLM_MODEL_ROUTES={}
# Example:
# LLM_MODEL_ROUTES={"local-small":"http://127.0.0.1:8101/v1","local-medium":"http://127.0.0.1:8102/v1","local-large":"http://127.0.0.1:8103/v1"}

# Optional per-Agent overrides. Blank values use MAIN/STRUCTURED/SAFETY defaults.
RISK_MODEL_NAME=
STATE_MODEL_NAME=
FEEDBACK_MODEL_NAME=
STRATEGY_MODEL_NAME=
RESPONSE_MODEL_NAME=
OUTPUT_GUARD_MODEL_NAME=
SUMMARY_MODEL_NAME=
SESSION_FINALIZER_MODEL_NAME=
MEMORY_CURATOR_MODEL_NAME=

LLM_TIMEOUT_SECONDS=60
LLM_THINKING_MODE=disabled

# Reviewed public-knowledge RAG. Keep both disabled until migrations, staging,
# review, and retrieval checks have completed.
RAG_ENABLED=false
RAG_TOP_K=4
RAG_TIMEOUT_MS=5000
RAG_MAX_CONTEXT_TOKENS=1200
RAG_RERANK_ENABLED=false
RAG_EMBEDDING_TIMEOUT_MS=1200
RAG_EMBEDDING_DIMENSIONS=512
EMBEDDING_MODEL_ENABLED=false
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
